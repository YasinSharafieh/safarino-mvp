# Server-only secrets. Never expose these values through NEXT_PUBLIC_ variables.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_FALLBACK_MODEL=mistralai/ministral-8b-2512

# Durable, atomic AI usage limits (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AI_DAILY_BUDGET_USD=0.32
AI_TOTAL_BUDGET_USD=8
AI_PER_REQUEST_BUDGET_USD=0.01

NEXT_PUBLIC_SITE_URL=

# Neshan Maps Platform (server only). Optional: a traveller can also paste their
# own key inside the app, in which case it stays in their browser.
# Free web-service key: https://platform.neshan.org/panel
NESHAN_API_KEY=
